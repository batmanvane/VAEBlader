\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Decoder Scheme with Region-Specific Constraints. A higher bias is applied to the nose control points ($P_1, P_2$) to prevent the leading edge from collapsing into a sharp wedge.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:decoder}{{4}{4}{Decoder Scheme with Region-Specific Constraints. A higher bias is applied to the nose control points ($P_1, P_2$) to prevent the leading edge from collapsing into a sharp wedge}{figure.4}{}}
