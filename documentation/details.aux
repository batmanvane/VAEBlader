\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Methodology Overview}{1}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the PIVAE approach. Raw data is converted to control points using a clustered topology, encoded into a disentangled latent space, and reconstructed via a physics-constrained decoder.}}{1}{figure.1}\protected@file@percent }
\newlabel{fig:overview}{{1}{1}{Overview of the PIVAE approach. Raw data is converted to control points using a clustered topology, encoded into a disentangled latent space, and reconstructed via a physics-constrained decoder}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The "Bridge" Strategy. The latent space is anchored from two sides: (1) The Encoder is forced to place latents at the correct physical label coordinates via KL divergence. (2) The Decoder is forced to respect these latents via a Consistency Loss that measures the generated geometry.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:bridge}{{2}{2}{The "Bridge" Strategy. The latent space is anchored from two sides: (1) The Encoder is forced to place latents at the correct physical label coordinates via KL divergence. (2) The Decoder is forced to respect these latents via a Consistency Loss that measures the generated geometry}{figure.2}{}}
