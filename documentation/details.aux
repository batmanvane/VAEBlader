\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Clustered Control Point Parameterization. Points $P_1$ and $P_2$ are packed near the leading edge to control the nose radius. The loss function treats these zones differently to avoid conflicting objectives.}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:cp_placement}{{3}{3}{Clustered Control Point Parameterization. Points $P_1$ and $P_2$ are packed near the leading edge to control the nose radius. The loss function treats these zones differently to avoid conflicting objectives}{figure.3}{}}
